root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning

# Every stream opened by the reader must be closed on all paths, also on errors (a file opened by a factory stays locked otherwise).
# Ownership passes to a wrapper constructor (PeekableStream, XmlReader) or to the method that receives the stream (CreateReader).
[src/**.cs]
dotnet_diagnostic.CA2000.severity = warning
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_method_call = true
