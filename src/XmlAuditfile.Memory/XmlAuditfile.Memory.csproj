<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageId>XmlAuditfile.Memory</PackageId>
    <Description>In-memory sink for XmlAuditfile: keeps all rows per table. Useful for tests, small files and the browser.</Description>
  </PropertyGroup>

  <!-- Becomes a package dependency on XmlAuditfile of the same version. -->
  <ItemGroup>
    <ProjectReference Include="..\XmlAuditfile\XmlAuditfile.csproj" />
  </ItemGroup>

</Project>
