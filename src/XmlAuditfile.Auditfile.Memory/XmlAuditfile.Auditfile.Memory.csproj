<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageId>XmlAuditfile.Auditfile.Memory</PackageId>
    <Description>In-memory sink for XmlAuditfile.Auditfile: keeps all rows per table. Useful for tests, small files and the browser.</Description>
