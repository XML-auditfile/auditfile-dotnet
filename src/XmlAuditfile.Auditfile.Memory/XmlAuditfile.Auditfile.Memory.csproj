  <!-- Becomes a package dependency on XmlAuditfile.Auditfile of the same version. -->
  <ItemGroup>
    <ProjectReference Include="..\XmlAuditfile.Auditfile\XmlAuditfile.Auditfile.csproj" />
  </ItemGroup>

</Project>
