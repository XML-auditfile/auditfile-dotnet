  </ItemGroup>

  <!-- The XAF 3.2 sample of this repository; variations are made in code. -->
  <ItemGroup>
    <None Include="Data\xaf-3.2-sample.xaf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
