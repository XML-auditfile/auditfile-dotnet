<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Starting versions; keep up to date with Dependabot once published. -->
  <ItemGroup>
    <!-- xunit v3 on Microsoft.Testing.Platform (global.json): no test SDK or VSTest adapter needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
